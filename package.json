{
  "name": "frameforge-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A node-based compositing studio starter for desktop.",
  "main": "desktop/main.cjs",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc -b && vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc -b --pretty",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.2.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "allowScripts": {
    "electron@45.2.1": true,
    "esbuild@0.25.12": true
  }
}
